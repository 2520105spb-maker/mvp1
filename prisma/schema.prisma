generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkOrderStatus {
  DRAFT
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  WAITING_MATERIALS
  WAITING_APPROVAL
  COMPLETED
  REJECTED
  CLOSED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MovementType {
  RECEIPT
  RESERVATION
  WRITE_OFF
  TRANSFER
  RETURN
  ADJUSTMENT
  AUDIT_CORRECTION
}

enum DomainEventStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

enum SyncStatus {
  QUEUED
  APPLIED
  CONFLICT
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

enum MediaStatus {
  LOCAL_PENDING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regions       Region[]
  customers     Customer[]
  users         IdentityUser[]
  workOrders    WorkOrder[]
  warehouses    Warehouse[]
  materials     Material[]
  auditRecords  AuditRecord[]
  domainEvents  DomainEvent[]

  @@index([slug])
}

model Region {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  objects     ServiceObject[]
  technicians Technician[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  inn       String?
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  objects ServiceObject[]

  @@index([tenantId, name])
  @@index([tenantId, deletedAt])
}

model ServiceObject {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String
  regionId    String
  address     String
  contractNo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  customer   Customer    @relation(fields: [customerId], references: [id])
  region     Region      @relation(fields: [regionId], references: [id])
  elevators  Elevator[]
  workOrders WorkOrder[]

  @@index([tenantId, regionId])
  @@index([tenantId, customerId])
  @@index([tenantId, address])
}

model Elevator {
  id            String   @id @default(cuid())
  tenantId      String
  objectId      String
  factoryNumber String
  manufacturer  String
  controller    String?
  model         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  object      ServiceObject @relation(fields: [objectId], references: [id])
  workOrders  WorkOrder[]
  mediaFiles  MediaFile[]

  @@unique([tenantId, factoryNumber])
  @@index([tenantId, objectId])
  @@index([tenantId, manufacturer])
}

model IdentityUser {
  id           String   @id @default(cuid())
  tenantId     String
  phone        String
  displayName  String
  email        String?
  passwordHash String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  technician   Technician?
  roles        UserRoleAssignment[]
  auditRecords AuditRecord[]
  approvals    Approval[]           @relation("ApprovalRequester")

  @@unique([tenantId, phone])
  @@index([tenantId, active])
}

model Technician {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String   @unique
  regionId  String
  code      String
  skills    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       IdentityUser @relation(fields: [userId], references: [id])
  region     Region       @relation(fields: [regionId], references: [id])
  workOrders WorkOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, regionId, active])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[]
  users       UserRoleAssignment[]

  @@unique([tenantId, code])
}

model Permission {
  id        String   @id @default(cuid())
  roleId    String
  action    String
  scope     String
  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, action, scope])
  @@index([action, scope])
}

model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  regionIds String[]
  objectIds String[]
  createdAt DateTime @default(now())

  user IdentityUser @relation(fields: [userId], references: [id])
  role Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model WorkOrder {
  id             String          @id @default(cuid())
  tenantId       String
  objectId       String
  elevatorId     String?
  technicianId   String?
  number         String
  typeCode       String
  status         WorkOrderStatus @default(DRAFT)
  priority       Priority        @default(MEDIUM)
  title          String
  description    String?
  acceptedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  closedAt       DateTime?
  serverVersion  Int             @default(1)
  offlineVersion Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  object       ServiceObject       @relation(fields: [objectId], references: [id])
  elevator     Elevator?           @relation(fields: [elevatorId], references: [id])
  technician   Technician?         @relation(fields: [technicianId], references: [id])
  materials    WorkOrderMaterial[]
  mediaFiles   MediaFile[]
  requirements PhotoRequirement[]
  signatures   Signature[]
  slaEvents    SLAEvent[]
  approvals    Approval[]
  emergency    EmergencyEvent?
  syncOps      SyncOperation[]

  @@unique([tenantId, number])
  @@index([tenantId, status, priority])
  @@index([tenantId, technicianId, status])
  @@index([tenantId, objectId, createdAt])
  @@index([tenantId, updatedAt])
}

model WorkOrderMaterial {
  id          String   @id @default(cuid())
  workOrderId String
  materialId  String
  quantity    Decimal  @db.Decimal(12, 3)
  reserved    Boolean  @default(false)
  writtenOff  Boolean  @default(false)
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  material  Material  @relation(fields: [materialId], references: [id])

  @@unique([workOrderId, materialId])
}

model PhotoRequirement {
  id          String   @id @default(cuid())
  workOrderId String
  code        String
  title       String
  required    Boolean  @default(true)
  satisfied   Boolean  @default(false)
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@unique([workOrderId, code])
}

model Signature {
  id          String   @id @default(cuid())
  workOrderId String
  signerRole  String
  signerName  String
  signedAt    DateTime?
  checksum    String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId, signerRole])
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  regionId  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  stockLevels  StockLevel[]
  reservations Reservation[]
  movements    MaterialMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model Material {
  id           String   @id @default(cuid())
  tenantId     String
  sku          String
  name         String
  categoryCode String
  unit         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  stockLevels        StockLevel[]
  reservations       Reservation[]
  movements          MaterialMovement[]
  workOrderMaterials WorkOrderMaterial[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryCode])
  @@index([tenantId, active])
}

model StockLevel {
  id          String   @id @default(cuid())
  warehouseId String
  materialId  String
  onHand      Decimal  @db.Decimal(14, 3)
  reserved    Decimal  @db.Decimal(14, 3)
  minLevel    Decimal  @db.Decimal(14, 3)
  maxLevel    Decimal  @db.Decimal(14, 3)
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  material  Material  @relation(fields: [materialId], references: [id])

  @@unique([warehouseId, materialId])
  @@index([materialId])
}

model Reservation {
  id          String   @id @default(cuid())
  warehouseId String
  materialId  String
  workOrderId String
  quantity    Decimal  @db.Decimal(14, 3)
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  material  Material  @relation(fields: [materialId], references: [id])

  @@index([warehouseId, materialId])
  @@index([workOrderId])
}

model MaterialMovement {
  id          String       @id @default(cuid())
  warehouseId String
  materialId  String
  workOrderId String?
  type        MovementType
  quantity    Decimal      @db.Decimal(14, 3)
  reason      String
  idempotencyKey String    @unique
  createdAt   DateTime     @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  material  Material  @relation(fields: [materialId], references: [id])

  @@index([warehouseId, createdAt])
  @@index([materialId, createdAt])
  @@index([workOrderId])
}

model SLAEvent {
  id          String   @id @default(cuid())
  workOrderId String
  profileCode String
  dueAt       DateTime
  breachedAt  DateTime?
  escalatedAt DateTime?
  state       String
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([state, dueAt])
  @@index([workOrderId])
}

model EmergencyEvent {
  id          String   @id @default(cuid())
  workOrderId String   @unique
  triggeredAt DateTime @default(now())
  acceptedAt  DateTime?
  severity    Priority @default(CRITICAL)
  passengerRisk Boolean @default(false)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([triggeredAt, severity])
}

model Approval {
  id          String         @id @default(cuid())
  workOrderId String?
  requesterId String
  type        String
  status      ApprovalStatus @default(PENDING)
  payload     Json
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())

  workOrder WorkOrder?   @relation(fields: [workOrderId], references: [id])
  requester IdentityUser @relation("ApprovalRequester", fields: [requesterId], references: [id])

  @@index([status, createdAt])
  @@index([workOrderId])
}

model MediaFile {
  id            String      @id @default(cuid())
  tenantId      String
  workOrderId   String?
  elevatorId    String?
  kind          String
  status        MediaStatus @default(LOCAL_PENDING)
  s3Key         String?
  checksum      String?
  metadata      Json
  createdAt     DateTime    @default(now())
  processedAt   DateTime?

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])
  elevator   Elevator?  @relation(fields: [elevatorId], references: [id])

  @@index([tenantId, workOrderId])
  @@index([tenantId, status, createdAt])
  @@index([checksum])
}

model Notification {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  alertType   String
  priority    Priority
  status      String
  payload     Json
  createdAt   DateTime @default(now())
  deliveredAt DateTime?
  readAt      DateTime?

  @@index([tenantId, userId, status])
  @@index([tenantId, priority, createdAt])
}

model SyncOperation {
  id             String     @id @default(cuid())
  tenantId       String
  workOrderId    String?
  deviceId       String
  operationType  String
  idempotencyKey String     @unique
  baseVersion    Int
  localVersion   Int
  status         SyncStatus @default(QUEUED)
  payload        Json
  conflict       Json?
  createdAt      DateTime   @default(now())
  appliedAt      DateTime?

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([tenantId, deviceId, status])
  @@index([tenantId, createdAt])
}

model AuditRecord {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  before      Json?
  after       Json?
  hash        String
  previousHash String?
  createdAt   DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  actor  IdentityUser? @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@unique([tenantId, hash])
}

model DomainEvent {
  id          String            @id @default(cuid())
  tenantId    String
  aggregateId String
  aggregateType String
  eventType   String
  payload     Json
  status      DomainEventStatus @default(PENDING)
  occurredAt  DateTime          @default(now())
  publishedAt DateTime?
  retryCount  Int               @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([status, occurredAt])
  @@index([tenantId, aggregateType, aggregateId])
}

model OutboxMessage {
  id          String            @id @default(cuid())
  eventId     String            @unique
  topic       String
  payload     Json
  status      DomainEventStatus @default(PENDING)
  availableAt DateTime          @default(now())
  lockedAt    DateTime?
  createdAt   DateTime          @default(now())

  @@index([status, availableAt])
}

model IdempotencyKey {
  key        String   @id
  tenantId   String
  scope      String
  response   Json?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([tenantId, scope])
  @@index([expiresAt])
}
