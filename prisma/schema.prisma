  steps           Json
  acknowledgedAt  DateTime?
  createdAt       DateTime        @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  incident EmergencyIncident @relation(fields: [incidentId], references: [id])

  @@index([tenantId, incidentId, createdAt])
  @@index([tenantId, currentLevel, autoEscalation])
}

model EmergencyResponse {
  id              String                 @id @default(cuid())
  tenantId        String
  incidentId      String
  phase           EmergencyResponsePhase @default(INTAKE)
  commandOwner    String
  activePlaybook  String
  nextAction      String
  safetyChecklist Json
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  incident EmergencyIncident @relation(fields: [incidentId], references: [id])

  @@index([tenantId, incidentId, phase])
}

model CriticalAlert {
  id            String                       @id @default(cuid())
  tenantId      String
  incidentId    String
  severity      IncidentPriority
  channel       EmergencyCommunicationChannel
  recipientRole String
  delivery      CriticalAlertDelivery        @default(QUEUED)
  message       String
  deliveredAt   DateTime?
  acknowledgedAt DateTime?
  createdAt     DateTime                     @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  incident EmergencyIncident @relation(fields: [incidentId], references: [id])

  @@index([tenantId, incidentId, createdAt])
  @@index([tenantId, delivery, createdAt])
  @@index([tenantId, severity, delivery])
}

model IncidentTimeline {
  id          String               @id @default(cuid())
  tenantId    String
  incidentId  String
  type        IncidentTimelineType
  label       String
  actor       String
  payload     Json?
  critical    Boolean              @default(false)
  occurredAt  DateTime             @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  incident EmergencyIncident @relation(fields: [incidentId], references: [id])

  @@index([tenantId, incidentId, occurredAt])
  @@index([tenantId, type, occurredAt])
}

model EmergencyGeoZone {
  id               String               @id @default(cuid())
  tenantId         String
  name             String
  risk             EmergencyGeoZoneRisk @default(NORMAL)
  activeIncidents  Int                  @default(0)
  nearestMechanics Int                  @default(0)
  avgEtaMinutes    Int                  @default(0)
  polygon          Json?
  updatedAt        DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, risk, activeIncidents])
}

model IncidentCommunication {
  id               String                      @id @default(cuid())
  tenantId         String
  incidentId       String
  mechanicId       String?
  lastContactAt    DateTime?
  status           IncidentCommunicationStatus @default(ONLINE)
  failedPushCount  Int                         @default(0)
  fallbackChannels EmergencyCommunicationChannel[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  incident EmergencyIncident @relation(fields: [incidentId], references: [id])

  @@index([tenantId, incidentId, status])
  @@index([tenantId, mechanicId, status])
}

model IncidentAuditLog {
  id            String              @id @default(cuid())
  tenantId      String
  incidentId    String
  action        IncidentAuditAction
  actor         String
  before        Json?
  after         Json?
  correlationId String
  hash          String
  previousHash  String?
  occurredAt    DateTime            @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  incident EmergencyIncident @relation(fields: [incidentId], references: [id])

  @@unique([tenantId, hash])
  @@index([tenantId, incidentId, occurredAt])
  @@index([tenantId, action, occurredAt])
  @@index([tenantId, correlationId])
}
